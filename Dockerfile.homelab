# Build Hindsight from source in this fork.
# The database is external (managed PostgreSQL), so no pg0 is bundled here.
FROM python:3.12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential curl git \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . /src

# hindsight-api is a meta-package over the hindsight-api-slim workspace member.
RUN pip install --no-cache-dir ./hindsight-api-slim

# Homelab tenant extension — must be importable by the extension loader at runtime.
RUN pip install --no-cache-dir --no-deps ./hindsight-homelab
RUN python -c "from hindsight_homelab.tenant import MultiKeyTenantExtension; print('extension importable')"

EXPOSE 8888 9999

CMD ["hindsight-api"]
